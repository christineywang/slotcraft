{
  "name": "slotcraft",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @slotcraft/api prisma:migrate",
    "db:seed": "pnpm --filter @slotcraft/api prisma:seed",
    "db:reset": "pnpm --filter @slotcraft/api prisma:reset"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
